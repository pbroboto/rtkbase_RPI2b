[Unit]
Description=RTKBase Ntrip A
Requires=str2str_tcp.service
After=str2str_tcp.service
[Service]
Type=simple
SyslogIdentifier=str2str_ntrip_A
User=rtkbase
ExecStart=/home/rtkbase/rtkbase/run_cast.sh in_tcp out_caster_A
Restart=on-failure
RestartSec=30
LogRateLimitIntervalSec=1 minute
LogRateLimitBurst=1
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/home/rtkbase/rtkbase
[Install]
WantedBy=multi-user.target
